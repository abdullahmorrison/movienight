# systemd --user unit: goes in ~/.config/systemd/user/.
# Runs as you, so it needs no root and cannot touch anything else on the box.
[Unit]
Description=Movie Night
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/movienight
# Pinned on purpose. nvm has no stable "current" path, so a Node upgrade means
# editing this line — better than a service that silently starts on the wrong one.
ExecStart=%h/.nvm/versions/node/v22.23.2/bin/node dist/index.js
Restart=always
RestartSec=5

# Shares the machine with other things, so it gets a ceiling.
MemoryMax=1G
CPUQuota=50%%

[Install]
WantedBy=default.target

# --- required ---
SESSION_SECRET=change-me-to-a-long-random-string
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
CHANNEL_LOGIN=abdullahmorrison

# Optional: left blank, it is looked up from CHANNEL_LOGIN at boot.
CHANNEL_ID=

# --- movie search + posters ---
# https://www.themoviedb.org/settings/api — v3 key or v4 read token both work.
# Without it, nominations fall back to plain typed titles and no posters.
TMDB_API_KEY=

# --- optional ---
PORT=3000
PUBLIC_URL=http://localhost:3000
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
DB_PATH=./movienight.db

BOT_ENABLED=true
BOT_TOKEN_FILE=./bot-tokens.json

SHORTLIST_SIZE=5
NOMINATIONS_PER_USER=2
POLL_DURATION_SECONDS=240
REPEAT_LOCKOUT_WEEKS=12
